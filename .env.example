LOCALSTACK_AUTH_TOKEN=

# 부하 테스트 설정 (docker-compose.monitoring.yml, 비우면 기본값 10)
SQS_MAX_CONCURRENT_MESSAGES=10
SQS_MAX_MESSAGES_PER_POLL=10
HIKARI_MAXIMUM_POOL_SIZE=10

# 입찰 큐 설정 (docker-compose.yml localstack, 큐를 만들 때만 읽으므로 바꾸면 localstack 컨테이너를 다시 만들어야 한다)
# 메시지 하나를 최대 몇 번 받을지 (첫 수신 포함, 재시도 횟수 = 이 값 - 1). 이 횟수째에도 실패하면 입찰 실패 처리 후 DLQ로 옮긴다
BID_QUEUE_MAX_RECEIVE_COUNT=3
# 메시지를 받은 뒤 다시 보이기까지의 시간(초) = 재시도 간격. 받은 시점부터 흐르고, 그동안 같은 경매의 다음 입찰은 기다린다
# 입찰 처리 로직 1건의 최악 시간(타임아웃 상한)보다 커야 중복 수신이 안 생긴다
BID_QUEUE_VISIBILITY_TIMEOUT=10

# 아웃박스 릴레이 설정 (docker-compose.monitoring.yml, 앱 컨테이너만 다시 띄우면 반영된다)
# 아웃박스가 비었을 때 다음 조회까지 쉬는 시간(ms). 쌓여 있으면 쉬지 않고 비울 때까지 발행한다. 작을수록 지연이 줄고 한가할 때 DB 조회가 는다
OUTBOX_RELAY_FIXED_DELAY=100
# 한 번에 조회해서 발행할 최대 건수. 클수록 조회 횟수가 줄고 한 번에 메모리에 올리는 양이 는다
OUTBOX_RELAY_BATCH_SIZE=100
